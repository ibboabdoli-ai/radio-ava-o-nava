name = "REPLACE_WITH_VERIFIED_PRODUCTION_WORKER"
account_id = "REPLACE_WITH_VERIFIED_PRODUCTION_ACCOUNT_ID"
main = "worker.js"
compatibility_date = "2026-11-01"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
preview_urls = false

# Bind the verified production database only after checking its schema and backup.
[[d1_databases]]
binding = "DB"
database_name = "REPLACE_WITH_VERIFIED_PRODUCTION_D1_NAME"
database_id = "REPLACE_WITH_VERIFIED_PRODUCTION_D1_ID"

[vars]
ALLOWED_ORIGIN = "https://radio.ibboabdoli.com"
RADIO_FEATURES_ENABLED = "false"
REGISTRATION_ENABLED = "false"
ATTENDANCE_OBSERVER_ENABLED = "false"
RADIO_DJ_ENABLED = "false"
ACCESS_PILOT_ENABLED = "false"
# Set AUTH_RATE_SECRET with wrangler secret put after staging review.
# Set OBSERVER_TOKEN only after an independent, validated presence source exists.
